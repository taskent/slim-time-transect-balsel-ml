// Contains SLiM scripts for negative frequency-dependent selection simulations
// @author: ozgur taskent
// @e-mail: ozgur.taskent86 [at] gmail.com

initialize() {
    // Simulate 50 kb segment
    defineConstant("L", 50000);
    defineConstant("Ne", 10000);

    // Output directory
    defineConstant(
        "OUTDIR" // Update with actual path
    );

    // Mutation and recombination rates
    initializeMutationRate(1e-8);
    initializeRecombinationRate(1e-8);

    // Neutral mutations
    initializeMutationType("m1", 0.5, "f", 0.0);

    // Target mutation; fitness effect is defined below in mutationEffect()
    initializeMutationType("m2", 0.5, "f", 0.0);
    m2.convertToSubstitution = F;

    // Genomic element
    initializeGenomicElementType("g1", m1, 1.0);
    initializeGenomicElement(g1, 0, L - 1);
}


1 early() {
    // Simulation ID based on seed
    defineConstant("simID", getSeed());

    // Temporary burn-in file and frequency output file
    defineConstant("TMPFILE", "/tmp/slim_" + simID + ".txt");
    defineConstant("FREQFILE", OUTDIR + "/freq_file.txt");

    // Add population: Ne = 10,000 diploids
    sim.addSubpop("p1", Ne);
}


100000 late() {
    // Save burn-in state before introducing target mutation
    sim.outputFull(TMPFILE);

    // Introduce target mutation into one genome at the center
    target = sample(p1.genomes, 1);
    target.addNewDrawnMutation(m2, asInteger(L / 2));
}


// Negative frequency-dependent fitness effect of the target mutation
// Selection coefficient declines as the target allele frequency increases.
// general formula: s(f) = 2 * s_target − (4 * s_target * f)
// for 2*Ne*s = 1000, s_target = 0.05 and formula: s(f) = 0.1 - 0.2*f
// so s = 0.1 when rare, s = 0 at f = 0.5, and s = -0.1 when fixed.
// The dominance term gives heterozygotes half the additive effect.
mutationEffect(m2) {
    freq = sim.mutationFrequencies(p1, mut);

    dominance = asInteger(homozygous) * 0.5 + 0.5;

    return 1.0 + ((0.1 - (freq * 2.0 / 10.0)) * dominance);
}


100000:140480 late() {
    tick = community.tick;

    // Count copies of target mutation
    total_mut_count = sum(p1.individuals.countOfMutationsOfType(m2));

    // Calculate target allele frequency
    freq = total_mut_count / (2 * Ne);

    // Current frequency-dependent selection coefficient
    // Same expression as in mutationEffect(), before dominance scaling
    s = 0.1 - (freq * 2.0 / 10.0);

    // Save frequency trajectory and current s
    writeFile(FREQFILE, paste(tick, freq, s), append = T);

    // If target mutation is lost, restart from saved burn-in state
    if (total_mut_count == 0) {
        print(simID + ": LOST-RESTARTING from generation 100000.");

        // Delete frequency trajectory from failed run
        deleteFile(FREQFILE);

        // Reload burn-in state
        sim.readFromPopulationFile(TMPFILE);

        // Change seed before reintroducing mutation
        setSeed(getSeed() + 1);

        // Reintroduce target mutation
        target = sample(p1.genomes, 1);
        target.addNewDrawnMutation(m2, asInteger(L / 2));
    }

    // If target mutation is fixed, restart from saved burn-in state
    if (total_mut_count == 2 * Ne) {
        print(simID + ": FIXED-RESTARTING from generation 100000.");

        // Delete frequency trajectory from failed run
        deleteFile(FREQFILE);

        // Reload burn-in state
        sim.readFromPopulationFile(TMPFILE);

        // Change seed before reintroducing mutation
        setSeed(getSeed() + 1);

        // Reintroduce target mutation
        target = sample(p1.genomes, 1);
        target.addNewDrawnMutation(m2, asInteger(L / 2));
    }

    // Sampling only between generations 140000 and 140480
    // Sampling every 40 generations = every 1000 years assuming 25 years/generation
    if (tick >= 140000 & tick <= 140480 & ((tick - 140000) % 40 == 0)) {
        label = (tick - 140000) * 25;

        p1.outputMSSample(
            200,
            replace = F,
            filePath = OUTDIR + "/p_" + label + ".ms"
        );
    }
}


140481 early() {
    // Remove temporary burn-in file
    deleteFile(TMPFILE);

    // End simulation
    sim.simulationFinished();
}
